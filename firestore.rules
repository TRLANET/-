rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPublicUser(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.isDiscoverable is bool &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.postsCount is int && data.postsCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPrivateUser(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBookmark(data, userId, postId) {
      return data.userId is string && data.userId == userId &&
             data.postId is string && data.postId == postId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserLikedPost(data, userId, postId) {
      return data.userId is string && data.userId == userId &&
             data.postId is string && data.postId == postId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPost(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
             data.authorHandle is string && data.authorHandle.size() >= 3 && data.authorHandle.size() <= 30 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 500 &&
             data.tag is string && data.tag.size() >= 1 && data.tag.size() <= 30 &&
             data.cardStyle is string && data.cardStyle in ['standard', 'quote', 'obsidian'] &&
             data.visibility is string && data.visibility in ['public'] &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPostLike(data, postId, userId) {
      return data.userId is string && data.userId == userId &&
             data.postId is string && data.postId == postId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidComment(data, postId) {
      return data.postId is string && data.postId == postId &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50 &&
             data.authorHandle is string && data.authorHandle.size() >= 3 && data.authorHandle.size() <= 30 &&
             (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFollow(data) {
      return data.followerId is string && data.followerId.size() >= 1 && data.followerId.size() <= 128 &&
             data.followedId is string && data.followedId.size() >= 1 && data.followedId.size() <= 128 &&
             data.followerId != data.followedId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidConversation(data) {
      return data.participantIds is list && data.participantIds.size() == 2 &&
             data.participantIds[0] is string && data.participantIds[1] is string &&
             data.participantIds[0] != data.participantIds[1] &&
             data.participantNames is map &&
             data.participantHandles is map &&
             (!('participantPhotos' in data) || data.participantPhotos is map) &&
             data.lastMessage is string && data.lastMessage.size() <= 500 &&
             data.lastSenderId is string && data.lastSenderId.size() <= 128 &&
             data.lastMessageAt is timestamp && data.lastMessageAt <= request.time &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMessage(data, conversationId) {
      return data.conversationId is string && data.conversationId == conversationId &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             data.participantIds[0] is string && data.participantIds[1] is string &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. Public social profiles (NO PII)
    match /users_public/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || existing().isDiscoverable == true || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (existing().isDiscoverable == true || existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().followersCount == 0 &&
                       incoming().followingCount == 0 &&
                       incoming().postsCount == 0 &&
                       incoming().keys().hasAll(['userId', 'displayName', 'username', 'isDiscoverable', 'followersCount', 'followingCount', 'postsCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'username', 'bio', 'photoUrl', 'isDiscoverable', 'followersCount', 'followingCount', 'postsCount', 'createdAt', 'updatedAt']) &&
                       isValidPublicUser(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidPublicUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Tier 1: Profile owner updating profile or own counters
                         (request.auth.uid == userId && (
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'bio', 'photoUrl', 'isDiscoverable', 'updatedAt']) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['postsCount', 'updatedAt']) &&
                            (incoming().postsCount == existing().postsCount + 1 || (incoming().postsCount == existing().postsCount - 1 && incoming().postsCount >= 0))) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt']) && (
                             (incoming().followingCount == existing().followingCount + 1) ||
                             (incoming().followingCount == existing().followingCount - 1 && incoming().followingCount >= 0)
                           ))
                         )) ||
                         // Tier 2: Another user atomically following/unfollowing this user
                         (request.auth.uid != userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']) && (
                            (incoming().followersCount == existing().followersCount + 1 &&
                             !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)) &&
                             existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))) ||
                            (incoming().followersCount == existing().followersCount - 1 &&
                             incoming().followersCount >= 0 &&
                             exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)) &&
                             !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)))
                          ))
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Private user PII and owner-only subcollections
    match /users_private/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt']) &&
                       isValidPrivateUser(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPrivateUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /bookmarks/{postId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(postId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'postId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'postId', 'createdAt']) &&
                         isValidBookmark(incoming(), userId, postId) &&
                         exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(postId) && request.auth.uid == userId;
      }

      match /likedPosts/{postId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(postId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'postId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'postId', 'createdAt']) &&
                         isValidUserLikedPost(incoming(), userId, postId) &&
                         existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(userId));
        allow delete: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(postId) &&
                         request.auth.uid == userId &&
                         !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(userId));
      }
    }

    // 3. Posts & interactions
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && (existing().visibility == 'public' || existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (existing().visibility == 'public' || existing().authorId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().keys().hasAll(['authorId', 'authorName', 'authorHandle', 'content', 'tag', 'cardStyle', 'visibility', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['authorId', 'authorName', 'authorHandle', 'authorPhotoUrl', 'content', 'tag', 'cardStyle', 'visibility', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         // Tier 1: Author editing post content/style
                         (existing().authorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'tag', 'cardStyle', 'visibility', 'authorName', 'authorHandle', 'authorPhotoUrl', 'updatedAt'])) ||
                         // Tier 2a: Atomic Like / Unlike
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) && (
                           (incoming().likesCount == existing().likesCount + 1 &&
                            !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)) &&
                            existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))) ||
                           (incoming().likesCount == existing().likesCount - 1 &&
                            incoming().likesCount >= 0 &&
                            exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)) &&
                            !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
                         )) ||
                         // Tier 2b: Comment count increment
                         (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) &&
                          incoming().commentsCount == existing().commentsCount + 1)
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorId == request.auth.uid;

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(userId) && (request.auth.uid == userId || exists(/databases/$(database)/documents/posts/$(postId)));
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'postId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'postId', 'createdAt']) &&
                         isValidPostLike(incoming(), postId, userId) &&
                         exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(userId) && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId) && exists(/databases/$(database)/documents/posts/$(postId));
        allow list: if isSignedIn() && existing().postId == postId;
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidComment(incoming(), postId) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().keys().hasAll(['postId', 'authorId', 'authorName', 'authorHandle', 'content', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'authorId', 'authorName', 'authorHandle', 'authorPhotoUrl', 'content', 'createdAt']) &&
                         exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && existing().authorId == request.auth.uid;
      }
    }

    // 4. Follows
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && (resource == null || existing().followerId == request.auth.uid || existing().followedId == request.auth.uid);
      allow list: if isSignedIn() && (existing().followerId == request.auth.uid || existing().followedId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(followId) &&
                       isValidFollow(incoming()) &&
                       incoming().followerId == request.auth.uid &&
                       followId == request.auth.uid + '_' + incoming().followedId &&
                       incoming().keys().hasAll(['followerId', 'followedId', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerId', 'followedId', 'createdAt']) &&
                       exists(/databases/$(database)/documents/users_public/$(incoming().followedId));
      allow delete: if isSignedIn() && isValidId(followId) && existing().followerId == request.auth.uid;
    }

    // 5. Direct Message Conversations & Messages
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (resource == null || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().keys().hasAll(['participantIds', 'participantNames', 'participantHandles', 'lastMessage', 'lastSenderId', 'lastMessageAt', 'createdAt']) &&
                       incoming().keys().hasOnly(['participantIds', 'participantNames', 'participantHandles', 'participantPhotos', 'lastMessage', 'lastSenderId', 'lastMessageAt', 'createdAt']);
      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'lastMessageAt', 'participantNames', 'participantHandles', 'participantPhotos']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && request.auth.uid in existing().participantIds;
        allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
        allow create: if isSignedIn() &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming(), conversationId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         incoming().keys().hasAll(['conversationId', 'senderId', 'participantIds', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['conversationId', 'senderId', 'participantIds', 'text', 'createdAt']) &&
                         exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  }
}
